#!/usr/bin/env python3
"""Demo "ssh" shim that simulates a fleet of remote Linux servers.

Loadbars starts one `ssh [opts] host "bash -s"` per host and reads the
loadbars protocol (M LOADAVG / M MEMSTATS / M NETSTATS / M DISKSTATS /
M CPUSTATS) from its stdout. Put this directory first in PATH and loadbars
talks to this script instead of real servers:

    PATH="$PWD/scripts/demo:$PATH" ./loadbars --hosts web01,web02,db01

Every host gets a deterministic load profile picked from its name prefix
(web, db, cache, build, backup; anything else is a quiet default), so the
usage-guide GIFs show clearly different servers even when recorded on a
single machine. Loadbars itself runs unmodified. Only used for docs.
"""

import math
import random
import sys
import time
import zlib

INTERVAL = 0.14  # same CPU sampling interval as loadbars-remote.sh
CPU_SAMPLES = 20  # CPU samples per protocol loop, like the real script
GBIT = 125_000_000  # bytes/s at 1 Gbit (loadbars' default netlink)
MB = 1_048_576


def wave(t, period, phase=0.0):
    """Smooth 0..1 oscillation."""
    return 0.5 + 0.5 * math.sin(2 * math.pi * t / period + phase)


def pulse(t, period, width, phase=0.0):
    """1 during a `width`-second window once every `period` seconds, else 0."""
    return 1.0 if (t + phase) % period < width else 0.0


def clamp(v, lo=0.0, hi=1.0):
    return max(lo, min(hi, v))


class Host:
    """One simulated server: turns elapsed time into /proc-style counters."""

    def __init__(self, name):
        self.name = name
        seed = zlib.crc32(name.encode())
        self.rng = random.Random(seed)
        self.phase = (seed % 1000) / 1000 * 2 * math.pi
        self.kind = next(
            (k for k in ("web", "db", "cache", "build", "backup") if name.startswith(k)),
            "default",
        )
        self.cores = {"db": 8, "build": 8, "cache": 2}.get(self.kind, 4)
        self.mem_total = {"db": 64, "cache": 32, "build": 16}.get(self.kind, 8) * MB  # kB
        self.swap_total = 4 * MB
        self.cpu = [[0.0] * 10 for _ in range(self.cores + 1)]  # [0] = aggregate
        self.net_rx = self.net_tx = 0.0
        self.disks = {"sda": [0.0, 0.0, 0.0]} if self.kind != "db" else {
            "nvme0n1": [0.0, 0.0, 0.0], "nvme1n1": [0.0, 0.0, 0.0]}
        self.load = [0.0, 0.0, 0.0]
        self.start = time.time()

    # --- load profiles (fractions 0..1) -------------------------------------

    def core_split(self, t, core):
        """Return (user, system, nice, iowait, irq, softirq, steal) for one core."""
        p, n = self.phase + core * 0.9, self.rng.random() * 0.06
        if self.kind == "web":
            busy = 0.25 + 0.55 * wave(t, 9, p) + n
            return busy * 0.7, busy * 0.22, 0.0, 0.01, 0.005, busy * 0.06, 0.0
        if self.kind == "db":
            busy = 0.2 + 0.3 * wave(t, 13, p) + n
            io = 0.15 + 0.35 * wave(t, 7, p + 1)
            return busy * 0.55, busy * 0.35, 0.0, io, 0.01, 0.02, 0.0
        if self.kind == "cache":
            busy = 0.1 + 0.15 * wave(t, 5, p) + n
            return busy * 0.4, busy * 0.5, 0.0, 0.0, 0.02, busy * 0.2, 0.0
        if self.kind == "build":
            burst = pulse(t, 16, 10, self.phase)
            busy = 0.05 + burst * (0.85 + n) + n
            return busy * 0.6, busy * 0.15, busy * 0.2, 0.02 * burst, 0.0, 0.01, 0.0
        if self.kind == "backup":
            io = 0.05 + 0.4 * pulse(t, 12, 6, self.phase)
            return 0.03 + n, 0.04, 0.0, io, 0.0, 0.0, 0.0
        busy = 0.05 + 0.1 * wave(t, 11, p) + n
        return busy * 0.6, busy * 0.3, 0.0, 0.01, 0.0, 0.0, 0.02 + 0.03 * wave(t, 17, p)

    def net_rates(self, t):
        """(rx, tx) in bytes/s."""
        p = self.phase
        if self.kind == "web":
            return GBIT * (0.1 + 0.3 * wave(t, 9, p)), GBIT * (0.2 + 0.6 * wave(t, 9, p))
        if self.kind == "cache":
            return GBIT * (0.3 + 0.4 * wave(t, 6, p)), GBIT * (0.4 + 0.5 * wave(t, 6, p + 2))
        if self.kind == "db":
            return GBIT * (0.05 + 0.2 * wave(t, 13, p)), GBIT * 0.1
        if self.kind == "backup":
            return GBIT * 0.8 * pulse(t, 12, 6, self.phase), GBIT * 0.02
        return GBIT * 0.02 * wave(t, 20, p), GBIT * 0.01

    def disk_rates(self, t, dev_idx):
        """(read, write) in bytes/s and utilisation 0..1."""
        p = self.phase + dev_idx * 2.1
        if self.kind == "db":
            r, w = 40 * MB * wave(t, 7, p), 90 * MB * wave(t, 5, p + 1)
            return r, w, clamp(0.3 + 0.6 * wave(t, 5, p))
        if self.kind == "backup":
            on = pulse(t, 12, 6, self.phase)
            return 120 * MB * on, 2 * MB, 0.05 + 0.9 * on
        if self.kind == "build":
            on = pulse(t, 16, 10, self.phase)
            return 10 * MB * on, 30 * MB * on * wave(t, 3, p), 0.4 * on
        return 0.2 * MB * wave(t, 8, p), 1.5 * MB * wave(t, 10, p), 0.05

    def mem_used(self, t):
        """(ram fraction, swap fraction)."""
        base = {"db": 0.65, "cache": 0.75, "build": 0.3, "web": 0.4}.get(self.kind, 0.2)
        ram = clamp(base + 0.25 * wave(t, 12, self.phase))
        if self.kind == "build":
            ram = clamp(base + 0.55 * pulse(t, 16, 10, self.phase))
        swap = 0.02
        if self.kind == "cache":
            swap = 0.2 + 0.3 * wave(t, 12, self.phase)  # swaps when RAM runs full
        return ram, swap

    # --- protocol output ----------------------------------------------------

    def advance_cpu(self, t, dt):
        ticks = dt * 10000  # finer than real jiffies; loadbars only uses ratios
        agg = [0.0] * 10
        for c in range(self.cores):
            us, sy, ni, io, irq, sirq, st = (clamp(v) for v in self.core_split(t, c))
            parts = [us, ni, sy, 0.0, io, irq, sirq, st]
            busy = sum(parts)
            if busy > 1:
                parts = [v / busy for v in parts]
                busy = 1.0
            parts[3] = 1.0 - busy  # idle
            for i, v in enumerate(parts):
                self.cpu[c + 1][i] += v * ticks
                agg[i] += v * ticks
        for i in range(10):
            self.cpu[0][i] += agg[i]

    def cpu_lines(self):
        out = []
        for idx, row in enumerate(self.cpu):
            name = "cpu" if idx == 0 else f"cpu{idx - 1}"
            out.append(name + " " + " ".join(str(int(v)) for v in row))
        return out

    def update_load(self, t, dt):
        running = sum(clamp(sum(self.core_split(t, c))) for c in range(self.cores))
        for i, window in enumerate((60, 300, 900)):
            # Faster than the kernel so the demo shows movement in seconds.
            decay = math.exp(-dt * 20 / window)
            self.load[i] = self.load[i] * decay + running * (1 - decay)

    def emit_loop(self, out):
        t = time.time() - self.start
        loop_dt = INTERVAL * CPU_SAMPLES
        self.update_load(t, loop_dt)

        out.write("M LOADAVG\n")
        out.write(";".join(f"{v:.2f}" for v in self.load) + "\n")

        ram, swap = self.mem_used(t)
        out.write("M MEMSTATS\n")
        out.write(f"MemTotal: {self.mem_total} kB\n")
        out.write(f"MemFree: {int(self.mem_total * (1 - ram))} kB\n")
        out.write(f"SwapTotal: {self.swap_total} kB\n")
        out.write(f"SwapFree: {int(self.swap_total * (1 - swap))} kB\n")

        rx, tx = self.net_rates(t)
        self.net_rx += rx * loop_dt
        self.net_tx += tx * loop_dt
        out.write("M NETSTATS\n")
        out.write("lo:b=0;tb=0;p=0;tp=0 e=0;te=0;d=0;td=0\n")
        out.write(f"eth0:b={int(self.net_rx)};tb={int(self.net_tx)};p=0;tp=0 e=0;te=0;d=0;td=0\n")

        out.write("M DISKSTATS\n")
        for i, (dev, ctr) in enumerate(self.disks.items()):
            r, w, util = self.disk_rates(t, i)
            ctr[0] += r * loop_dt / 512
            ctr[1] += w * loop_dt / 512
            ctr[2] += util * loop_dt * 1000
            out.write(f"{dev}:rs={int(ctr[0])};ws={int(ctr[1])};rt=0;wt=0;io={int(ctr[2])}\n")

        out.write("M CPUSTATS\n")
        for _ in range(CPU_SAMPLES):
            self.advance_cpu(time.time() - self.start, INTERVAL)
            out.write("\n".join(self.cpu_lines()) + "\n")
            out.flush()
            time.sleep(INTERVAL)


def host_from_args(argv):
    """ssh is called as: ssh [-o opt]... [-l user] host 'bash -s'."""
    args = [a for a in argv[1:]]
    return args[-2] if len(args) >= 2 else "demo"


def main():
    host = Host(host_from_args(sys.argv))
    sys.stdin.read()  # the embedded remote script; not needed here
    try:
        while True:
            host.emit_loop(sys.stdout)
    except (BrokenPipeError, KeyboardInterrupt):
        pass


if __name__ == "__main__":
    main()
